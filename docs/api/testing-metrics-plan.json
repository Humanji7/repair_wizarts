          "target": "< 5% increase from baseline"
        },
        {
          "metric": "test_coverage",
          "command": "npm run test:coverage -- --json",
          "file": "coverage/coverage-final.json",
          "measurement": "Coverage comparison",
          "target": "≥ 90% coverage on migrated modules"
        },
        {
          "metric": "build_time",
          "command": "time npm run build",
          "file": "build.log",
          "measurement": "Build time impact",
          "target": "< 10% increase from baseline"
        },
        {
          "metric": "api_response_time",
          "command": "npm run test:performance -- --measureApiCalls",
