        },
        {
          "command": "npm run test:integration -- --testPathPattern=shared/api",
          "description": "Run integration tests for API modules",
          "expected": "All integration tests passing"
        },
        {
          "command": "npm run typecheck",
          "description": "TypeScript type checking",
          "expected": "No TypeScript errors"
        },
        {
          "command": "npx knip",
          "description": "Check for unused files and dependencies",
          "expected": "No critical unused dependencies"
        },
        {
          "command": "npm run build",
          "description": "Build application",
          "expected": "Successful build without errors"
        },
        {
          "command": "npm run test:e2e -- --spec='auth/**/*.spec.ts'",
          "description": "Run e2e tests for auth flows",
          "expected": "All critical auth tests passing"
        }
