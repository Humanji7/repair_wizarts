          "command": "npm run test:integration -- --testPathPattern=shared/api",
          "description": "Verify integration tests after migration",
          "expected": "All tests passing"
        },
        {
          "command": "npm run test:regression -- --testPathPattern=migration",
          "description": "Run regression tests for migrated functionality",
