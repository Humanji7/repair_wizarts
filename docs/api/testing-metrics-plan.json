    "metrics": {
      "preMigration": [
        {
          "metric": "bundle_size",
          "command": "npm run build:analyze",
          "file": "build/static/js/*.js",
          "measurement": "Total bundle size in KB",
          "baseline": "Current production bundle size"
        },
        {
          "metric": "test_coverage",
          "command": "npm run test:coverage -- --json",
          "file": "coverage/coverage-final.json",
          "measurement": "Coverage percentage for API modules",
          "baseline": "Current coverage levels"
        },
        {
          "metric": "build_time",
          "command": "time npm run build",
          "file": "build.log",
          "measurement": "Build duration in seconds",
          "baseline": "Current build time"
        },
        {
          "metric": "type_errors",
          "command": "npm run typecheck 2>&1 | tee typecheck.log",
          "file": "typecheck.log",
          "measurement": "Number of TypeScript errors",
          "baseline": "Current error count"
        },
        {
          "metric": "lint_errors",
          "command": "npm run lint 2>&1 | tee lint.log",
          "file": "lint.log",
          "measurement": "Number of linting errors",
          "baseline": "Current lint error count"
        },
        {
          "metric": "test_duration",
          "command": "time npm run test:unit",
          "file": "test-duration.log",
          "measurement": "Unit test execution time",
          "baseline": "Current test duration"
        },
        {
          "metric": "unused_dependencies",
